{
  "extends": "astro/tsconfigs/strict",
  "include": [
  ".astro/types.d.ts",
  ".astro/integrations/**/*.d.ts",
  "**/*"
],
"exclude": [
  "dist",
  "node_modules",
  "public/pagefind",
  "studio/dist"
],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["astro/client"]
  }
}