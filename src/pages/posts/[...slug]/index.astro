---
import PostLayout from "@/layouts/PostLayout.astro";
import PortableText from "@/components/sanity/PortableText.astro";
import {
  type Post,
  getAllPosts,
  getAdjacentPosts,
} from "@/utils/content";

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((post) => {
    const { prevPost, nextPost } =
      getAdjacentPosts(posts, post);

    return {
      params: {
        slug: post.slug,
      },
      props: {
        post,
        prevPost,
        nextPost,
      },
    };
  });
}

type Props = {
  post: Post;
  prevPost: Post | null;
  nextPost: Post | null;
};

const {
  post,
  prevPost,
  nextPost,
} = Astro.props;
---

<PostLayout
  post={post}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <PortableText value={post.body} />
</PostLayout>