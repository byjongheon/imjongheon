---
import { type Post } from "@/utils/content";
import { formatDate } from "@/utils/date";

type Props = {
  post: Post;
  showLanguage?: boolean;
  accentCategory?: boolean;
};

const {
  post,
  showLanguage = false,
  accentCategory = false,
} = Astro.props;

const { category, published, updated, lang } = post;

const displayDate = formatDate(updated ?? published);
---

{
  category && (
    <span
      class:list={[
        "",
        { "text-primary": accentCategory },
      ]}
    >
      {category}
    </span>
  )
}

<time
  datetime={published.toISOString()}
  class="tabular-nums"
>
  {displayDate}
</time>

{
  showLanguage && lang && (
    <span class="uppercase">
      {lang}
    </span>
  )
}